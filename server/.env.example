# SFTP 服务
SFTP_PORT=2222
SFTP_HOST=0.0.0.0

# Web API 服务
WEB_PORT=3000
WEB_HOST=0.0.0.0

# JWT 密钥 — 生产环境请替换为随机长字符串，例如：
# openssl rand -hex 32
JWT_SECRET=your-secret-key-change-me

# 文件存储根目录（相对路径或绝对路径）
SFTP_ROOT=./sftp-root

# 默认管理员账号（首次启动时自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
