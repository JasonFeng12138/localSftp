# SFTP 服务
SFTP_PORT=2222
SFTP_HOST=0.0.0.0

# Web API 服务
WEB_PORT=3000
WEB_HOST=0.0.0.0

# JWT 密钥 — 至少 32 个字符，例如：openssl rand -hex 32
# 留空则自动生成随机密钥并保存在 data/jwt-secret（推荐）
JWT_SECRET=

# 文件存储根目录（相对路径或绝对路径），不能包含 data/、host-keys/、logs/ 目录
SFTP_ROOT=./sftp-root

# 默认管理员账号（仅在没有任何用户时首次启动创建）
# ADMIN_PASSWORD 留空则随机生成并打印到控制台
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 单个上传文件大小上限（MB），留空表示不限制
MAX_UPLOAD_MB=
